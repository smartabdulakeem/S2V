# ── Rendered output (large files, machine-specific) ──────────────────────────
cache/
output/
logs/

# ── FFmpeg and Piper binaries (downloaded by setup.bat) ──────────────────────
vendor/

# ── User settings / API keys ─────────────────────────────────────────────────
config/settings.json

# ── Machine-specific UI state (absolute paths, changes every session) ────────
config/last_project.json

# ── Python bytecode ───────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd

# ── PyInstaller build artefacts ───────────────────────────────────────────────
build/
dist/
*.spec

# ── Common OS / editor clutter ────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
.vscode/
.idea/

.vercel

# ── Image Library dynamic directories ───────────────────────────────────────
library/images/
library/_inbox/
library/_sheets/
library/_rejected/
library/render_usage.json

projects/
temp_animated_drawings/
test_cache/

# ── TTS model weights (764MB, re-downloadable, exceed GitHub's 100MB limit) ──
config/kokoro/
config/kokoro_models/

# ── Generated library thumbnails ─────────────────────────────────────────────
library/_thumbnails/

# ── Pre-refactor backups ─────────────────────────────────────────────────────
*.pre-voicestudio

# ── Google Drive sync scratch ────────────────────────────────────────────────
.tmp.driveupload/

