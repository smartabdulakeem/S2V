# ── Rendered output (large files, machine-specific) ──────────────────────────
cache/
output/
logs/

# ── FFmpeg and Piper binaries (downloaded by setup.bat) ──────────────────────
vendor/

# ── User settings / API keys ─────────────────────────────────────────────────
config/settings.json

# ── Python bytecode ───────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd

# ── PyInstaller build artefacts ───────────────────────────────────────────────
build/
dist/
*.spec

# ── Common OS / editor clutter ────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
.vscode/
.idea/

.vercel

# ── Image Library dynamic directories ───────────────────────────────────────
library/images/
library/_inbox/
library/_sheets/
library/_rejected/

